def get_data(symbol):
    try:
        url = f"https://api.binance.com/api/v3/klines?symbol={symbol}&interval=1m&limit=100"
        res = requests.get(url, timeout=10).json()
        df = pd.DataFrame(res, columns=['t', 'o', 'h', 'l', 'c', 'v', 'ct', 'qv', 'tr', 'bv', 'bqv', 'i'])
        return df.astype(float)
    except: return None

def check_strategy(df):
    price = df['c'].iloc[-1]
    h_max = df['h'].iloc[-50:].max()
    l_min = df['l'].iloc[-30:].min()
    if price >= h_max * 0.9998: return "🔴 SELL 📉"
    if price <= l_min * 1.0002: return "🔵 BUY 📈"
    return None

